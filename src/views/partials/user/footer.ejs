<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
  body {
  font-family: 'Montserrat', Arial, sans-serif;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ==============================
   STANDARD PROFESSIONAL FOOTER
   Pinkish + Clean + Elegant
   ============================== */

footer.footer {
  background: linear-gradient(180deg, #fff6f9 0%, #fff0f5 55%, #ffffff 100%);
  padding: 65px 0 35px;
  color: #555;
  font-size: 14px;
  border-top: 1px solid rgba(214, 51, 132, 0.12);
  position: relative;
}

/* thin top accent line */
footer.footer::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, #ffd1dc, #d63384, #ffd1dc);
}

/* container */
footer .container {
  width: 88%;
  max-width: 1200px;
  margin: 0 auto;
}

/* columns row */
footer .row {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 25px;
  margin-bottom: 35px;
}

/* each column */
footer .col-md-3 {
  flex: 1;
  min-width: 220px;
}

/* headings */
footer h5 {
  font-size: 17px;
  font-weight: 700;
  margin-bottom: 18px;
  color: #c2185b;
  letter-spacing: 0.5px;
  position: relative;
  padding-bottom: 10px;
}

/* small underline */
footer h5::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 45px;
  height: 2px;
  background: #f8bbd0;
  border-radius: 10px;
}

/* list */
footer ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

footer ul li {
  margin: 12px 0;
}

/* links */
footer ul li a {
  text-decoration: none;
  color: #666;
  font-size: 14px;
  font-weight: 500;
  transition: 0.25s ease;
}

footer ul li a:hover {
  color: #d63384;
  padding-left: 6px;
}

/* bottom section */
.footer-bottom {
  border-top: 1px solid rgba(214, 51, 132, 0.12);
  padding-top: 20px;
  text-align: center;
  margin-top: 10px;
}

/* copyright */
.copyright {
  font-size: 13px;
  color: #888;
  font-weight: 500;
}

/* ==============================
   RESPONSIVE
   ============================== */

@media (max-width: 992px) {
  footer .container {
    width: 92%;
  }
}

@media (max-width: 768px) {
  footer.footer {
    padding: 50px 0 30px;
  }

  footer .row {
    flex-direction: column;
    gap: 35px;
  }

  footer .col-md-3 {
    text-align: center;
  }

  footer h5::after {
    left: 50%;
    transform: translateX(-50%);
  }

  footer ul li a:hover {
    padding-left: 0;
  }
}

    </style>
</head>
<body>

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-3">
                    <h5>About Information</h5>
                    <ul class="list-unstyled">
                        <li><a href="/about">About Us</a></li>
                        <li><a href="/contact">Contact Us</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Products</h5>
                    <ul class="list-unstyled">
                        <li><a href="/shop">Skincare</a></li>
                        <li><a href="shop">Makeup</a></li>
                        <li><a href="#">Special Offers</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Store Information</h5>
                    <ul class="list-unstyled">
                        <li><a href="#">123 Beauty Street</a></li>
                        <li><a href="#">Phone: (555) 123-4567</a></li>
                        <li><a href="#">Email: info@example.com</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Follow Us</h5>
                    <ul class="list-unstyled">
                        <li><a href="https://facebook.com" target="_blank">Facebook</a></li>
                        <li><a href="https://instagram.com" target="_blank">Instagram</a></li>
                        <li><a href="https://twitter.com" target="_blank">Twitter</a></li>
                        <li><a href="https://youtube.com" target="_blank">YouTube</a></li>
                    </ul>
                </div>
                
            </div>
            <div class="footer-bottom">
                <div class="copyright">
                    &copy; 2025 Beauty Store. All rights reserved.
                </div>
            </div>
        </div>
    </footer>

</body>
</html>